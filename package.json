{
  "name": "sun-solar-system-sim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "True-scale, physically accurate 3D solar system flight simulator",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsc --noEmit && vitest run",
    "fixtures": "node tools/fetch-fixtures.mjs",
    "assets": "node tools/fetch-assets.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.180.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
